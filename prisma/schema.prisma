generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  ACCOUNTANT
  CASHIER
  DATA_ENTRY
  AUDITOR
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntrySide {
  DEBIT
  CREDIT
}

enum VoucherType {
  RECEIPT
  PAYMENT
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  fullName     String
  passwordHash String
  role         UserRole   @default(DATA_ENTRY)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  journals     JournalEntry[] @relation("JournalPoster")
  vouchers     Voucher[]  @relation("VoucherCreator")
  auditLogs    AuditLog[]
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(3)
  name      String
  symbol    String
  precision Int      @default(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  accounts  Account[]
  cashBoxes CashBox[]
  journalLines JournalLine[]
  vouchers  Voucher[]
}

model Account {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  currencyId  String?
  active      Boolean     @default(true)
  system      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]   @relation("AccountTree")
  currency    Currency?   @relation(fields: [currencyId], references: [id])
  journalLines JournalLine[]
  client      Client?
  cashBox     CashBox?
}

model Client {
  id            String   @id @default(cuid())
  accountNumber String   @unique
  name          String
  phone         String?
  address       String?
  accountId     String   @unique
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  account       Account  @relation(fields: [accountId], references: [id])
  vouchers      Voucher[]
}

model CashBox {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  currencyId String
  accountId  String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  currency   Currency @relation(fields: [currencyId], references: [id])
  account    Account  @relation(fields: [accountId], references: [id])
  vouchers   Voucher[]
}

model JournalEntry {
  id          String       @id @default(cuid())
  reference   String       @unique
  entryDate   DateTime     @default(now())
  memo        String
  postedById  String
  createdAt   DateTime     @default(now())
  postedBy    User         @relation("JournalPoster", fields: [postedById], references: [id])
  lines       JournalLine[]
  voucher     Voucher?
  @@index([entryDate])
}

model JournalLine {
  id         String    @id @default(cuid())
  journalId  String
  accountId  String
  currencyId String
  side       EntrySide
  amount     Decimal   @db.Decimal(20, 6)
  memo       String?
  journal    JournalEntry @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currency  Currency  @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  @@index([accountId, currencyId])
  @@index([journalId])
}

model Voucher {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  type          VoucherType
  date          DateTime    @default(now())
  clientId      String
  cashBoxId     String
  currencyId    String
  amount        Decimal     @db.Decimal(20, 6)
  description   String
  createdById   String
  journalId     String      @unique
  createdAt     DateTime    @default(now())
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  cashBox       CashBox     @relation(fields: [cashBoxId], references: [id], onDelete: Restrict)
  currency      Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createdBy     User        @relation("VoucherCreator", fields: [createdById], references: [id])
  journal       JournalEntry @relation(fields: [journalId], references: [id], onDelete: Restrict)
  @@index([date, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  @@index([entityType, entityId])
  @@index([createdAt])
}
